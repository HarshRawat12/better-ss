<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>BetterSS</AssemblyName>
    <Title>Better SS</Title>
    <Product>Better SS</Product>
    <ApplicationIcon>Assets\better-ss.ico</ApplicationIcon>
    <!-- WPF owns startup; WinForms is used only for Screen and NotifyIcon.
         DPI awareness must be established by the manifest before any HWND exists. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Version>0.3.0</Version>
    <Authors>Harsh Rawat and contributors</Authors>
    <Description>A local-first screenshot, annotation, OCR, and screen-recording utility for Windows.</Description>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/HarshRawat12/better-ss</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\capture.mp3" Condition="Exists('Assets\capture.mp3')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Custom Sounds\*.mp3" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Tools\ffmpeg.exe" Condition="Exists('Tools\ffmpeg.exe')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="ffmpeg.exe" />
    <Content Include="Tools\ffprobe.exe" Condition="Exists('Tools\ffprobe.exe')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="ffprobe.exe" />
    <Content Include="Tools\FFmpeg-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="FFmpeg-LICENSE.txt" />
  </ItemGroup>
</Project>
